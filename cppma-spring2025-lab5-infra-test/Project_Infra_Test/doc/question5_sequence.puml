@startuml
' Question 5 : diagramme de sequence - un pas de simulation Lennard-Jones
' suivi d'une sauvegarde VTK (scenario de Lab4/question6.cxx + Univers::sauvegarderVTK).

actor Chercheur
participant "main" as Main
participant "Univers" as U
participant "Particule" as P
participant "Cellule" as C
participant "Fichier .vtu" as F

Chercheur -> Main : lancer la simulation
activate Main

Main -> U : avancerLennardJones(dt)
activate U

loop pour chaque particule i
    U -> P : getForce()
    U -> P : setPosition(nouvellePosition)
end

U -> U : mettreAJourCellules()
activate U #DDDDDD
loop pour chaque particule i
    U -> U : nouvelleCellule = indiceLineaire(coordonneesCellule(...))
    alt nouvelleCellule != celluleDeParticule[i]
        U -> C : retirerParticule(i)
        U -> C : ajouterParticule(i)
    end
end
deactivate U

U -> U : recalculerForcesLennardJones()
activate U #DDDDDD
loop pour chaque paire (i, j) de cellules voisines
    U -> U : ajouterForceLennardJones(i, j)
    U -> P : setForce(force mise a jour)
end
deactivate U

loop pour chaque particule i
    U -> P : setVitesse(nouvelleVitesse)
end

deactivate U

Main -> U : sauvegarderVTK(nomFichier)
activate U
U -> F : ecrire Position, Velocity, Masse (XML VTK)
deactivate U

deactivate Main

@enduml
