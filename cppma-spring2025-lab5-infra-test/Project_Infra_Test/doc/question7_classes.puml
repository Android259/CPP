@startuml
' Question 7 : diagramme de classes (conception, cf. Cours 05 - style
' "diagramme de classes de conception" : types, visibilite, operations completes).

skinparam classAttributeIconSize 0

class Vector {
    -x : double
    -y : double
    -z : double
    +Vector()
    +Vector(x : double, y : double, z : double)
    +getX() : double
    +getY() : double
    +getZ() : double
    +norm() : double
    +operator+=(autre : Vector&) : Vector&
    +operator-=(autre : Vector&) : Vector&
    +operator*=(k : double) : Vector&
    +operator/=(k : double) : Vector&
    +operator-() : Vector
    +operator==(autre : Vector&) : bool
    +operator*(autre : Vector&) : double
}

class Particule {
    -position : Vector
    -vitesse : Vector
    -force : Vector
    -masse : double
    -invMasse : double
    -id : int
    -type : int
    +Particule(masse : double)
    +Particule(x, y, z, vx, vy, vz, masse, id, type, fx, fy, fz)
    +getMasse() : double
    +setMasse(m : double) : void
    +getInvMasse() : double
    +getPosition() : Vector&
    +setPosition(p : Vector&) : void
    +getVitesse() : Vector&
    +setVitesse(v : Vector&) : void
    +getForce() : Vector&
    +setForce(f : Vector&) : void
    +getId() : int
    +setId(i : int) : void
    +getType() : int
    +setType(t : int) : void
}

class Cellule {
    -indicesParticules : vector<size_t>
    +ajouterParticule(indice : size_t) : void
    +retirerParticule(indice : size_t) : void
    +vider() : void
    +getIndicesParticules() : vector<size_t>&
    +taille() : size_t
}

class GrilleCellules {
    -dimension : int
    -longueursCaracteristiques : vector<double>
    -rayonCoupure : double
    -nombreCellules : vector<int>
    -cellules : vector<Cellule>
    -celluleDeParticule : vector<size_t>
    -voisinsDeCellule : vector<vector<size_t>>
    +GrilleCellules(dimension, L, rcoup)
    +placerParticules(particules : vector<Particule>&) : void
    +mettreAJour(particules : vector<Particule>&) : void
    +getNombreCellules(d : size_t) : int
    +getCellules() : vector<Cellule>&
    +getCellule(indice : size_t) : Cellule&
    +voisinsDe(indice : size_t) : vector<size_t>&
    +cellulesVoisines(position : Vector&) : vector<size_t>
}

class ExportateurVTK {
    +{static} exporter(particules : vector<Particule>&, nomFichier : string) : void
}

class Univers {
    -dimension : int
    -particules : vector<Particule>
    -forceAncienne : vector<Vector>
    -longueursCaracteristiques : vector<double>
    -rayonCoupure : double
    -epsilon : double
    -sigma : double
    -grille : GrilleCellules
    +Univers(dimension, n, masse, vitesseInitiale)
    +Univers(dimension, n, masse, vitesseInitiale, L, rcoup, epsilon, sigma)
    +getDimension() : int
    +getNombreParticules() : int
    +getParticule(i : size_t) : Particule&
    +setPosition(i : size_t, position : Vector&) : void
    +initialiserCellules() : void
    +mettreAJourCellules() : void
    +cellulesVoisines(position : Vector&) : vector<size_t>
    +recalculerForces() : void
    +recalculerForcesLennardJones() : void
    +avancer(dt : double) : void
    +avancerLennardJones(dt : double) : void
    +sauvegarderVTK(nomFichier : string) : void
}

Univers "1" *-- "n" Particule : contient >
Univers "1" *-- "1" GrilleCellules : delegue la grille >
Univers ..> ExportateurVTK : delegue l'export >
GrilleCellules "1" *-- "n" Cellule : organise >
Cellule ..> Particule : reference (indice) >
Particule "1" *-- "3" Vector : position, vitesse, force >
ExportateurVTK ..> Particule : lit >

@enduml
