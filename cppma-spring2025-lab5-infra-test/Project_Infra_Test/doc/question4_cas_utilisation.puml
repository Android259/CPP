@startuml
' Question 4 : diagramme des cas d'utilisation du projet de simulation
' de particules (gravitation / Lennard-Jones + visualisation VTK).

left to right direction

actor "Chercheur" as Chercheur
actor "Developpeur" as Dev
actor "ParaView" as ParaView

rectangle "Simulation de particules" {
    usecase "Configurer l'univers\n(dimension, N, masse, L, rcoup, epsilon, sigma)" as UC1
    usecase "Initialiser les positions\ndes particules" as UC2
    usecase "Lancer une simulation\ngravitationnelle" as UC3
    usecase "Lancer une simulation\nLennard-Jones" as UC4
    usecase "Exporter les donnees\nau format VTK" as UC5
    usecase "Visualiser les resultats" as UC6
    usecase "Executer les tests\nunitaires (gtest)" as UC7
}

Chercheur --> UC1
Chercheur --> UC2
Chercheur --> UC3
Chercheur --> UC4
Chercheur --> UC5
Dev --> UC7

UC3 ..> UC2 : <<include>>
UC3 ..> UC1 : <<include>>
UC4 ..> UC2 : <<include>>
UC4 ..> UC1 : <<include>>
UC5 ..> UC6 : <<extend>>
UC6 --> ParaView

@enduml
